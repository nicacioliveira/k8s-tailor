# Copy to .env (cp env.example .env). Dotfiles are git-ignored.
#
# --- Source mode ---
# local      -> dev loop: kubectl port-forward to vmsingle + API server (run `bun dev` on your machine)
# in-cluster -> packaged in the chart (uses in-cluster ServiceAccount + vmsingle Service DNS)
SOURCE=local

# vmsingle MetricsQL endpoint (port-forward target in local mode)
VM_URL=http://127.0.0.1:8428

# HTTP port for the tailor API + UI
PORT=8080

# HTTPS port + TLS material for the (opt-in) mutating webhook
TLS_PORT=8443
TLS_CERT_FILE=/etc/webhook/tls/tls.crt
TLS_KEY_FILE=/etc/webhook/tls/tls.key

# --- Decisions store (ClickHouse, optional locally: decisions stay in memory when empty) ---
CH_URL=
CH_DATABASE=tailor
CH_USER=
CH_PASSWORD=
CH_RETENTION_DAYS=90

# --- Recommender window/algorithm ---
WINDOW=7d
CPU_QUANTILE=0.90
MEM_QUANTILE=0.95
MARGIN=0.15
HALF_LIFE=24h
# cpu usage query: avg = rate() (smooths bursts) | max = rollup_rate(...,"max")
CPU_RATE_MODE=avg
# minimum observations before a workload may be actuated (confidence gate)
MIN_SAMPLES=30
# floors for any recommendation
MIN_CPU_MILLI=10
MIN_MEM_MI=32
# how often to recompute recommendations / reconcile actuation
REFRESH_EVERY=60s
RECONCILE_EVERY=30s
# overview trend chart
TREND_WINDOW=3h
TREND_STEP_SEC=60

# --- Limits policy (QoS) ---
# memory limit = recommended memory request * MEM_LIMIT_FACTOR, floored at the
# observed peak × (1+MARGIN). Applied ONLY to containers that already declare a
# memory limit — a limit is never introduced (except by the OOM-learned floor).
MEM_LIMIT_FACTOR=1.0
# cpu limit = recommended cpu request * CPU_LIMIT_FACTOR (0 or empty = no cpu limit, avoids throttling)
CPU_LIMIT_FACTOR=0

# --- OOM-learned memory floor ---
# When a container is OOMKilled, its memory LIMIT is re-protected durably at
# (observed limit * OOM_GROWTH_FACTOR): a later Down/trim can never crush the limit
# back below the value that killed it, so OOM-prone workloads protect themselves
# instead of needing manual exclusion. Forgotten OOM_FLOOR_TTL after the last OOM.
OOM_LEARN=true
OOM_GROWTH_FACTOR=1.5
OOM_FLOOR_TTL=30d

# --- Pricing ---
# static (fixed rates below) | opencost (measured node cost) | aws (stub)
PRICING_MODE=static

# --- Static pricing (no OpenCost locally) ---
# rough on-demand blended rates; only used to rank waste, not for billing
PRICE_CPU_CORE_HR=0.031
PRICE_GB_HR=0.004

# --- Scope ---
EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,k8s-tailor

# --- MCP server (mcp/) ---
# Engine API the MCP server proxies
TAILOR_API=http://127.0.0.1:8080
# Bearer token required on /mcp (empty = auth disabled; dev only)
MCP_API_TOKEN=

# --- API auth ---
# Bearer token required on the MUTATING endpoints (POST/DELETE /api/pause,
# /api/policies, /api/groups, /api/workload). Empty = open (a warning is logged).
TAILOR_API_TOKEN=
# true = fail closed (503 on writes) when TAILOR_API_TOKEN is empty
TAILOR_API_AUTH_REQUIRED=false
