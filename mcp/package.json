{
  "name": "k8s-tailor-mcp",
  "version": "0.1.0",
  "description": "MCP app for k8s-tailor: tools to inspect recommendations, preview patches and consult the optional LLM advisor, plus write tools (pause, policies, groups, per-workload overrides) gated by the engine API token; React UI embeddable in MCP-capable hosts. Proxies the Go engine's HTTP API.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot ./server/main.ts",
    "dev:web": "vite --config vite.config.tool.ts --port 5179 --strictPort",
    "build:web": "TOOL_ENTRY=dashboard-ui vite build --config vite.config.tool.ts",
    "build": "bun run build:web && bun build ./server/main.ts --outfile ./dist/server/main.js --target bun",
    "start": "bun run ./dist/server/main.js",
    "check": "tsc --noEmit",
    "format": "biome format --write server web vite.config.tool.ts",
    "test": "bun test server web"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.120.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
