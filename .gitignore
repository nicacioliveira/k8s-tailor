# secrets / local env
.env
.env.*
!env.example
*.local

# deps
node_modules/

# builds
/bin/
dist/
# web/dist holds the UI the Go binary embeds (//go:embed dist/*). Only the
# placeholder is versioned, so `go build ./...` works on a clean clone; the real
# index.html comes from `make ui-build` (or the Dockerfile) and stays ignored.
!web/dist/
web/dist/*
!web/dist/.gitkeep
*.test
*.out
coverage/

# helm packaged deps (regenerated by `helm dep build`)
chart/charts/*.tgz
chart/charts/

# editors / OS / misc
*.log
.DS_Store
.idea/
.vscode/
.context/
